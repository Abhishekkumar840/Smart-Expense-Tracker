# ==========================================================
# SERVER
# ==========================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================================
# DATABASE
# ==========================================================
# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-expense-tracker?retryWrites=true&w=majority

# ==========================================================
# JWT AUTH
# ==========================================================
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==========================================================
# EMAIL (Nodemailer - used for verification & password reset)
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Smart Expense Tracker <no-reply@expensetracker.com>"

# ==========================================================
# FILE UPLOAD
# ==========================================================
MAX_FILE_UPLOAD_MB=5
UPLOAD_DIR=uploads

# ==========================================================
# RATE LIMITING
# ==========================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
